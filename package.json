{
  "name": "nestovin",
  "private": true,
  "description": "Nestovin V1 monorepo: shared backend, Next.js web app (public site + /admin), Resident and Worker apps",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @nestovin/api dev",
    "build": "pnpm -r --workspace-concurrency=4 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "pnpm --filter @nestovin/api db:types",
    "dev:web": "pnpm --filter @nestovin/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "eslint": "10.15.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "supabase": "3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "type": "module"
}
