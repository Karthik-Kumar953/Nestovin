{
  "name": "@nestovin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Nestovin shared backend: Express modular monolith",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup src/server.ts --format esm --target node24 --clean --sourcemap",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:setup-local": "tsx --env-file-if-exists=.env scripts/setup-local-db-roles.ts",
    "bootstrap:super-admin": "tsx --env-file-if-exists=.env scripts/bootstrap-super-admin.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts"
  },
  "dependencies": {
    "@nestovin/contracts": "workspace:*",
    "@supabase/supabase-js": "^2.119.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "kysely": "^0.29.9",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "read-excel-file": "^9.3.17",
    "write-excel-file": "^4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
