# Copy to .env for local development. Never commit .env.
# Values below match a local `pnpm db:start` (Supabase CLI). Run `pnpm db:setup-local` once
# to give the app_api role a local login password.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Restricted runtime role through the local pooler (transaction mode, port 54329).
# Pooler usernames are <role>.<project_id>; the local project_id is "nestovin".
DATABASE_URL=postgresql://app_api.nestovin:local-dev-only-app-api@127.0.0.1:54329/postgres
# Superuser URL used ONLY by local setup scripts and integration tests (never by the running API).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
APP_API_LOCAL_PASSWORD=local-dev-only-app-api

SUPABASE_URL=http://127.0.0.1:54321
# From `pnpm exec supabase status` (JWT secret and service_role key):
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

CORS_ORIGINS=http://localhost:3000
ADMIN_REQUIRE_MFA=true
IP_HASH_SALT=change-me-to-a-long-random-string
ADMIN_PORTAL_URL=http://localhost:3000/admin
# SUPPORT_ENQUIRY_EMAIL=support@example.com

# Razorpay (test mode keys for dev). Without key id + secret, online payments are disabled.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=
# Webhook secret set in Razorpay Dashboard -> Webhooks (events: payment.captured, order.paid, refund.processed)
# RAZORPAY_WEBHOOK_SECRET=
# Resident phone OTP: MSG91 DLT template + Supabase Auth Send SMS hook (see docs/integrations.md)
# SUPABASE_SMS_HOOK_SECRET=v1,whsec_...
# MSG91_AUTH_KEY=
# MSG91_OTP_TEMPLATE_ID=
# MSG91_OTP_VARIABLE=otp
# Google Maps Geocoding (server-side) for community pins
# GOOGLE_MAPS_API_KEY=
# Push notifications (Firebase service account). Without these, notifications stay in-app only.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Transactional email (Resend). Without these, email notifications are skipped.
# RESEND_API_KEY=
# EMAIL_FROM="Nestovin <no-reply@your-domain>"
# Periodic maintenance (reconciliation, expiry); set false to disable
# JOBS_ENABLED=true

# ---- Demo mode (development only; the API refuses to start with either set to true in production) ----
# Dev-only test payments: with no Razorpay keys, a built-in test provider is used and the Resident
# app shows "Test booking" (POST /v1/resident/payments/test-complete). Ignored when Razorpay keys are set.
# TEST_PAYMENTS_ENABLED=false
# Dev-only Resident demo login (POST /v1/public/demo-login) as the seeded demo resident with this phone.
# Run `corepack pnpm --filter @nestovin/api seed:dev-demo` with the same DEMO_RESIDENT_PHONE first.
# DEMO_LOGIN_ENABLED=false
# DEMO_RESIDENT_PHONE=+919999900001
