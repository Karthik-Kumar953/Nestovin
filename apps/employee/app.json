{
  "expo": {
    "name": "Nestovin Worker",
    "slug": "nestovin-worker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nestovin-worker",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.nestovin.employee",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the resident's check-in QR code.",
        "NSLocationWhenInUseUsageDescription": "Your location is recorded once, only when you check in to a visit."
      }
    },
    "android": {
      "package": "in.nestovin.employee",
      "adaptiveIcon": {
        "backgroundColor": "#E5F3F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION"],
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION", "android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F5FAF9"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the resident's check-in QR code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is recorded once, only when you check in to a visit.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00796B"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
