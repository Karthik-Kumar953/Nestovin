# Public values only (bundled into the app). Secrets stay in apps/api/.env.
EXPO_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# API base URL reachable from the phone: your computer's LAN IP (e.g. http://192.168.1.10:4000),
# http://10.0.2.2:4000 for the Android emulator, or the staging/production API URL.
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# TEMPORARY, for client showcases only. NEVER enable in production builds.
# When true, the welcome and sign-in screens show a "Demo login" button that signs in the seeded demo
# resident through the API (POST /v1/public/demo-login, which must also be switched on server-side).
EXPO_PUBLIC_DEMO_LOGIN=false
