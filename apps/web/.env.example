# Copy to .env.local. NEXT_PUBLIC_* values are PUBLIC by design (they ship in the browser bundle).
# Never put the service-role key, database URLs or any secret in this app.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_..., Project Settings -> API Keys). Public by design.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Leave empty in development: /v1 is proxied to the local API on http://localhost:4000.
NEXT_PUBLIC_API_URL=
