{
  "name": "@nestovin/ui-native",
  "version": "0.0.0",
  "private": true,
  "description": "Shared React Native building blocks for the Resident and Worker apps (NativeWind + Reanimated 4, Nestovin tokens)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "dependencies": {
    "@nestovin/design-tokens": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ../../apps/resident"
  },
  "nestovin": {
    "hostProvides": [
      "react",
      "react-native",
      "react-native-reanimated",
      "react-native-worklets",
      "react-native-safe-area-context",
      "react-native-svg",
      "expo-glass-effect",
      "expo-haptics",
      "expo-image",
      "expo-linear-gradient",
      "@expo/vector-icons",
      "nativewind"
    ]
  }
}
